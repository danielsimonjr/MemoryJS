{
  "name": "@danielsimonjr/memoryjs",
  "version": "3.0.0",
  "description": "Core knowledge graph library with search, storage, and graph algorithms",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./search": {
      "import": {
        "types": "./dist/search/index.d.ts",
        "default": "./dist/search/index.js"
      },
      "require": {
        "types": "./dist/search/index.d.cts",
        "default": "./dist/search/index.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent/index.d.ts",
        "default": "./dist/agent/index.js"
      },
      "require": {
        "types": "./dist/agent/index.d.cts",
        "default": "./dist/agent/index.cjs"
      }
    },
    "./features": {
      "import": {
        "types": "./dist/features/index.d.ts",
        "default": "./dist/features/index.js"
      },
      "require": {
        "types": "./dist/features/index.d.cts",
        "default": "./dist/features/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.js"
      },
      "require": {
        "types": "./dist/adapters/index.d.cts",
        "default": "./dist/adapters/index.cjs"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security/index.d.ts",
        "default": "./dist/security/index.js"
      },
      "require": {
        "types": "./dist/security/index.d.cts",
        "default": "./dist/security/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "memory": "dist/cli/index.js",
    "memoryjs": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "node -e \"process.env.IGNORE_UNHANDLED_REJECTIONS='true';require('child_process').execSync('vitest run --exclude=tests/performance/**',{stdio:'inherit',env:process.env})\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test:ci",
    "tools:install": "cd tools/chunking-for-files && npm install && cd ../compress-for-context && npm install && cd ../create-dependency-graph && npm install && cd ../migrate-from-jsonl-to-sqlite && npm install",
    "tools:build": "cd tools/chunking-for-files && npm run build && cd ../compress-for-context && npm run build && cd ../create-dependency-graph && npm run build && cd ../migrate-from-jsonl-to-sqlite && npm run build",
    "tools:deps": "node tools/create-dependency-graph/create-dependency-graph.ts",
    "tools:check-duplicates": "node tools/create-dependency-graph/check-duplicates.mjs",
    "benchmark": "tsx benchmarks/synthetic-bench.ts",
    "audit:plans": "tsx tools/plan-doc-audit/audit.ts",
    "bench": "vitest run tests/performance"
  },
  "keywords": [
    "knowledge-graph",
    "graph-database",
    "entity-management",
    "search",
    "sqlite",
    "jsonl",
    "semantic-search",
    "hybrid-search"
  ],
  "author": "Daniel Simon Jr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/memoryjs.git"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/memoryjs/issues"
  },
  "homepage": "https://github.com/danielsimonjr/memoryjs#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@danielsimonjr/workerpool": "^10.2.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "chrono-node": "^2.9.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^10.7.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
