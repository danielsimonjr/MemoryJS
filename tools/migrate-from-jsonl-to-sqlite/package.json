{
  "name": "migrate-from-jsonl-to-sqlite",
  "version": "1.1.0",
  "description": "Migration tool for Memory MCP - converts between JSONL and SQLite storage formats",
  "scripts": {
    "build": "npm run build:ts && npm run build:exe",
    "build:ts": "tsc",
    "build:exe": "npx @yao-pkg/pkg . --target node22-win-x64 --output migrate-from-jsonl-to-sqlite.exe",
    "start": "node dist/migrate-from-jsonl-to-sqlite.js",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs"
  },
  "bin": {
    "migrate-from-jsonl-to-sqlite": "./dist/migrate-from-jsonl-to-sqlite.js"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/better-sqlite3/prebuilds/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@yao-pkg/pkg": "^6.11.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tar": "^7.5.11",
    "picomatch": "^4.0.4"
  }
}
